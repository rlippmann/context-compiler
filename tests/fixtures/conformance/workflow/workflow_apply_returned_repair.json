      "input": "prohibit docker",
      "label": "prohibit_step"
    },
    {
      "fn": "step",
      "input": "use docker",
      "label": "conflict"
    },
    {
      "fn": "apply_repair",
      "decision_ref": "conflict",
      "repair_index": 0,
      "label": "remove_repair"
