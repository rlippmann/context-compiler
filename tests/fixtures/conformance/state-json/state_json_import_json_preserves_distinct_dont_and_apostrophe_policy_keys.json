  "initial_state": {
    "premise": null,
    "policies": {},
    "version": 2
  },
  "action": {
    "fn": "import_json",
    "payload": "{\"premise\":null,\"policies\":{\"dont\":\"prohibit\",\"don't\":\"use\"},\"version\":2}"
  },
  "expected": {
    "state": {
      "premise": null,
      "policies": {
        "don't": "use",
        "dont": "prohibit"
